---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const brief = (p?: (typeof all)[number]) => (p ? { id: p.id, title: p.data.title } : null);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: brief(all[i - 1]), next: brief(all[i + 1]) } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, stack, role, year, links, cover } = entry.data;
const linkLabels: [keyof typeof links, string][] = [['live', 'Live site'], ['code', 'Code'], ['docs', 'Screen layouts']];
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CreativeWork', name: title, description: summary, url,
    author: { '@type': 'Person', name: site.name }, keywords: stack.join(', '),
    sameAs: [links.live, links.code].filter(Boolean),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<Base title={`${title} — Sanjay Lagariya`} description={summary}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <p class="more" style="margin-top:0"><a href="/projects/">All projects</a></p>
  <h1 class="page-title">{title}</h1>
  <p class="lede" style="margin-top:1.2rem">{summary}</p>
  <img class="banner" src={cover ?? `/covers/${entry.id}.svg`} alt={`Screenshot of ${title}`} width="800" height="500" />
  <div class="case">
    <dl class="facts">
      {role && <><dt>Role</dt><dd>{role}</dd></>}
      {year && <><dt>Year</dt><dd>{year}</dd></>}
      {stack.length > 0 && <><dt>Stack</dt><dd>{stack.join(', ')}</dd></>}
      <dt>Links</dt>
      <dd>{linkLabels.filter(([k]) => links[k]).map(([k, label]) => <a href={links[k]} target="_blank" rel="noopener noreferrer">{label}</a>)}</dd>
    </dl>
    <div class="prose"><Content /></div>
  </div>
  <nav class="pager" aria-label="More projects">
    {prev ? <a class="prev" href={`/projects/${prev.id}/`}><span>Previous project</span><strong>{prev.title}</strong></a> : <span />}
    {next ? <a class="next" href={`/projects/${next.id}/`}><span>Next project</span><strong>{next.title}</strong></a> : <span />}
  </nav>
</Base>

<style>
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; margin-top: 4.5rem; padding-top: 1.4rem; border-top: 2px solid var(--fg); }
  .pager a { display: block; text-decoration: none; padding: 0.4rem 0; }
  .pager a:hover { background: none; color: inherit; }
  .pager a:hover strong { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .pager span { display: block; font: 500 0.95rem var(--display); color: var(--soft); }
  .pager strong { display: block; font: 700 clamp(1.1rem, 1rem + 0.5vw, 1.4rem)/1.25 var(--display); font-stretch: 90%; }
  .next { text-align: right; grid-column: 2; }
  @media (max-width: 34rem) { .pager { grid-template-columns: 1fr; } .next { grid-column: 1; text-align: left; } }
</style>
