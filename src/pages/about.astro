---
import Base from '../layouts/Base.astro';
import { site, bio, skills, timeline } from '../data/site';
---
<Base title="About — Sanjay Lagariya" description="About Sanjay Lagariya: a full-stack developer from Gujarat, India. Skills, education and experience.">
  <div class="about-top">
    <div>
      <h1 class="page-title">About</h1>
      <p class="lede" style="margin-top:1.2rem">I am a full-stack developer based in Gujarat, India, working at {site.employer}.</p>
      {bio.map((para) => <p>{para}</p>)}
    </div>
    <img class="portrait" src="/portrait.svg" alt="Portrait of Sanjay Lagariya" width="480" height="576" />
  </div>

  <section aria-labelledby="been">
    <h2 id="been">Where I’ve been</h2>
    <dl class="timeline">
      {timeline.map((t) => <><dt>{t.when}</dt><dd><strong>{t.what}</strong>{t.note && <span>{t.note}</span>}</dd></>)}
    </dl>
  </section>

  <section aria-labelledby="use">
    <h2 id="use">What I work with</h2>
    <dl class="skills">{skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
  </section>

  <p class="more" style="margin-top:3rem">For a one-page summary, <a href={site.resume}>read my resume</a>.</p>
</Base>
