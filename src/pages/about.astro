---
import Base from '../layouts/Base.astro';
import { site, skills, timeline } from '../data/site';
---
<Base title="About — Sanjay Lagariya" description="About Sanjay Lagariya: a full-stack developer from Gujarat, India. Skills, education and experience.">
  <h1 class="page-title">About</h1>
  <p class="lede" style="margin-top:1.2rem">I am a full-stack developer based in Gujarat, India. I work with React, Next.js, Node.js, Express and MongoDB, and I like turning a rough idea into something that runs.</p>

  <section aria-labelledby="been">
    <h2 id="been">Where I’ve been</h2>
    <dl class="timeline">
      {timeline.map((t) => (
        <><dt data-todo={t.todo ? '' : undefined}>{t.when}</dt>
        <dd data-todo={t.todo ? '' : undefined}><strong>{t.what}</strong>{t.note && <span>{t.note}</span>}</dd></>
      ))}
    </dl>
  </section>

  <section aria-labelledby="use">
    <h2 id="use">What I work with</h2>
    <dl class="skills">{skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
  </section>

  <p class="more" style="margin-top:3rem">For a one-page summary, <a href={site.resume}>read my resume</a>.</p>
</Base>
